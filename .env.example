# Copy to .env; never commit real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Explicit optional local provider; never chosen automatically.
MODEL_PROVIDER=gemini
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
COOKIE_SECURE=false
# Keep at 1 with the built-in single-process mutation coordinator.
WEB_CONCURRENCY=1
WORKSPACE_DAILY_RUNS=3
GLOBAL_DAILY_RUNS=10
MAX_WORKSPACES=30
MAX_MODEL_TURNS=8
RUN_TIMEOUT_SECONDS=120

