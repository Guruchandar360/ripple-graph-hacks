# Copy to .env; never commit real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=13
# Verify account access and quota. This model passed a direct native-tool probe;
# the older 2.5 model returned 404 for this account. No automatic fallback.
# Explicit optional local provider; never chosen automatically.
MODEL_PROVIDER=gemini
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TOOL_MODE=json
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
COOKIE_SECURE=false
# Keep at 1 with the built-in single-process mutation coordinator.
WEB_CONCURRENCY=1
WORKSPACE_DAILY_RUNS=3
GLOBAL_DAILY_RUNS=10
MAX_WORKSPACES=30
MAX_MODEL_TURNS=8
RUN_TIMEOUT_SECONDS=120

